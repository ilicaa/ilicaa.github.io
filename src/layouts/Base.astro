---
import { Font, fontData, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/data';
import { isTodo } from '../lib/projects';

interface Props {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  /** Social preview image; defaults to /og-default.png. Cropped to 1200×630. */
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, image, imageAlt, type = 'website', noindex = false } = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.lookingFor.primary.join(' & ')}`;
const desc = description && !isTodo(description) ? description : site.seoDescription;
const canonical = new URL(Astro.url.pathname, Astro.site);

const ogImage = image
  ? new URL((await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpeg' })).src, Astro.site)
  : new URL('/og-default.png', Astro.site);
const ogAlt = image && imageAlt ? imageAlt : `${site.name} — ${site.lookingFor.primary.join(' & ')}`;

// Preload only the Latin, upright files of the display and body faces (first variant of each, per astro.config.mjs).
const preloads = ['--font-display', '--font-body'].map((v) => fontData[v as keyof typeof fontData]?.[0]?.src[0]?.url).filter(Boolean);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#111214" />
    <meta name="author" content={site.name} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {preloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-mono" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    inset-inline-start: var(--gutter);
    top: -100px;
    z-index: 10;
    padding: var(--space-2xs) var(--space-s);
    background: var(--c-accent);
    color: var(--c-on-accent);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-s);
  }
  .skip-link:focus {
    top: var(--space-xs);
  }
  body {
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
  }
  main:focus {
    outline: none;
  }
</style>
