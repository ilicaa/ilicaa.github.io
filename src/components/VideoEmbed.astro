---
// Privacy-friendly, click-to-load video. Without JS it is a plain link to the video.
// Nothing from YouTube/Vimeo loads until the visitor presses play (except the YouTube thumbnail image).
interface Props {
  provider: 'youtube' | 'vimeo';
  id: string;
  title: string;
}
const { provider, id, title } = Astro.props;

const watchUrl = provider === 'youtube' ? `https://www.youtube.com/watch?v=${id}` : `https://vimeo.com/${id}`;
const embedUrl =
  provider === 'youtube'
    ? `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`
    : `https://player.vimeo.com/video/${id}?autoplay=1&dnt=1`;
const thumb = provider === 'youtube' ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg` : undefined;
---

<figure class="video">
  <a class="facade" href={watchUrl} data-embed={embedUrl} data-title={title}>
    {thumb && <img src={thumb} alt="" width="480" height="360" loading="lazy" decoding="async" />}
    <span class="play" aria-hidden="true"></span>
    <span class="visually-hidden">Play video: {title}</span>
  </a>
  <figcaption>{title}</figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a.facade[data-embed]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = link.dataset.embed!;
      iframe.title = link.dataset.title ?? 'Video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      link.replaceWith(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .video {
    display: grid;
    gap: var(--space-2xs);
  }
  .facade,
  .video :global(iframe) {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--c-surface);
  }
  .facade img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity var(--dur-fast);
  }
  .facade:hover img {
    opacity: 1;
  }
  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--c-accent);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--c-bg) 50%, transparent);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .play::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    translate: 3px 0;
    width: 0;
    height: 0;
    border-block: 0.75rem solid transparent;
    border-inline-start: 1.2rem solid var(--c-on-accent);
  }
  .facade:hover .play {
    transform: scale(1.06);
  }
  figcaption {
    font-size: var(--step--1);
    color: var(--c-muted);
  }
</style>
