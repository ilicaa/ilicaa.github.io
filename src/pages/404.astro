---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page doesn’t exist." noindex>
  <section class="wrap notfound" aria-labelledby="nf-heading">
    <p class="label code">Error 404</p>
    <h1 id="nf-heading">This level hasn’t been built yet.</h1>
    <p class="lede">The page you’re looking for doesn’t exist or has moved.</p>
    <ul role="list" class="actions">
      <li><a class="button" href="/projects/">See projects</a></li>
      <li><a class="button button--ghost" href="/">Go to the home page</a></li>
    </ul>
  </section>
</Base>

<style>
  .notfound {
    padding-block: var(--space-3xl) var(--space-xl);
  }
  .code {
    color: var(--c-accent);
  }
  h1 {
    margin-block-start: var(--space-s);
    max-width: 16ch;
  }
  .lede {
    margin-block-start: var(--space-m);
    color: var(--c-muted);
    font-size: var(--step-1);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-start: var(--space-l);
  }
</style>
